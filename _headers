# Cache static assets aggressively
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Shared JS + CSS — keep TTL short. These ship the site header, search
# index, mega menu, and footer; a 7-day cache bit us hard on launch day
# when navigation/search changes didn't reach returning visitors. 5 min +
# must-revalidate is the right shape for "stale revalidates quickly" — the
# browser sends If-None-Match, Netlify edge ETags do the work.
/shared/*.js
  Cache-Control: public, max-age=300, must-revalidate

/shared/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.css
  Cache-Control: public, max-age=86400

# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
